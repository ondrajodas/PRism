# macOS
.DS_Store

# Podpis — jméno certifikátu je vlastnost stroje, ne repa (bin/setup-signing.sh)
Signing.local.xcconfig

# Slot pracovního stromu (#228) — vlastnost toho konkrétního stromu, ne repa. Kdyby se
# commitl, přinesl by cizí slot do každého dalšího checkoutu.
.prism-slot

# Pracovní stromy subagentů (#231). Harness je zakládá uvnitř repa, takže by je hlavní strom
# viděl jako neverzované soubory — a `git add -A` v něm by commitl cizí rozdělanou práci.
.claude/worktrees/

# Lokální oprávnění Claude Code — grant vázaný na účet, ne na repo. Pouští zápis do
# soukromého sandboxu pro spike #62; do verzovaného souboru nepatří právě proto, že
# repo má tvrdou podmínku „aplikace na GitHub nic neposílá“.
.claude/settings.local.json

# Xcode
build.noindex/
# Zůstává kvůli složkám z doby před #139 a kvůli buildu bez -derivedDataPath:
# `git status` zavalený artefakty je horší než řádek navíc.
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
xcuserdata/
*.moved-aside
*.hmap

# Buildy a symboly
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager
.build/
.swiftpm/

# Brainstorming companion (vizuální mockupy, lokální server)
.superpowers/
