<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Aplikace mluví česky, takže to musí vědět i bundle. Bez deklarované lokalizace
	     spadne `Locale.current` na vývojový jazyk a relativní časy v seznamu vyjdou
	     anglicky („2 hours ago“) vedle českých popisků. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>cs</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>cs</string>
	</array>
	<!-- CFBundleName jde do menu baru, CFBundleDisplayName do Finderu a Docku.
	     Proč vlastní Info.plist a ne GENERATE_INFOPLIST_FILE: CFBundleName se generuje
	     z PRODUCT_NAME a klíč INFOPLIST_KEY_CFBundleName Xcode tiše ignoruje. Původně
	     se tím řešil rozdíl mezi názvem produktu a názvem pro uživatele; po sjednocení
	     na PRism ten důvod odpadl a plist by šel zrušit — viz CLAUDE.md. -->
	<key>CFBundleDisplayName</key>
	<string>PRism</string>
	<key>CFBundleName</key>
	<string>PRism</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
</dict>
</plist>
