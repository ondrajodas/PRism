<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Aplikace mluví česky, takže to musí vědět i bundle. Bez deklarované lokalizace
	     spadne `Locale.current` na vývojový jazyk a relativní časy v seznamu vyjdou
	     anglicky („2 hours ago“) vedle českých popisků. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>cs</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>cs</string>
	</array>
	<!-- CFBundleName jde do menu baru, CFBundleDisplayName do Finderu a Docku.
	     Proč vlastní Info.plist a ne GENERATE_INFOPLIST_FILE: CFBundleName se generuje
	     z PRODUCT_NAME a klíč INFOPLIST_KEY_CFBundleName Xcode tiše ignoruje. Původně
	     se tím řešil rozdíl mezi názvem produktu a názvem pro uživatele; po sjednocení
	     na PRism ten důvod odpadl — od #228 ho ale plní znovu, tentokrát kvůli slotům.

	     PRISM_SLOT_LABEL je prázdný, dokud se nebuildí do slotu; hlavní checkout se tedy
	     jmenuje „PRism“ jako dřív a build ve slotu „a“ se jmenuje „PRism-a“ — label je
	     `-${SLOT}` a slot se používá doslova. Není to kosmetika:
	     CFBundleName určuje i kořen cache (CacheLayout.applicationSupport), takže prázdná
	     hodnota znamená společnou cache s produkční instancí. -->
	<key>CFBundleDisplayName</key>
	<string>PRism$(PRISM_SLOT_LABEL)</string>
	<key>CFBundleName</key>
	<string>PRism$(PRISM_SLOT_LABEL)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Ikona leží v asset catalogu (`App/Assets.xcassets`), takže tady musí být jméno
	     jejího setu. Xcode ho do plistu **negeneruje**, protože GENERATE_INFOPLIST_FILE je
	     vypnuté — bez tohohle klíče se ikona zkompiluje do Assets.car, ale systém ji nenajde
	     a v Docku zůstane prázdný obdélník. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<!-- `Otevřít session v Terminálu` (#453) posílá Apple event do `Terminal.app` (přes
	     `osascript`). Bez tohohle klíče macOS event odmítne kódem -1743 a **ani se nezeptá**:
	     TCC ho přisuzuje odpovědnému procesu, tedy aplikaci, ne tomu podprocesu — takže se
	     účel musí říct tady, i když ho posílá `osascript`. Text jde do systémového dialogu. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>PRism otevře session revieweera v Terminálu — pustí v něm claude --resume v pracovním stromu té session.</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
</dict>
</plist>
