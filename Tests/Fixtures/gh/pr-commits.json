[{"sha":"c82266c2dcc3285033605501837434af1faeddfe","node_id":"C_kwDOTayMUNoAKGM4MjI2NmMyZGNjMzI4NTAzMzYwNTUwMTgzNzQzNGFmMWZhZWRkZmU","commit":{"author":{"name":"imkp1","email":"kprateek.bit@gmail.com","date":"2026-07-16T19:39:23Z"},"committer":{"name":"imkp1","email":"kprateek.bit@gmail.com","date":"2026-07-16T19:39:23Z"},"message":"Warn instead of failing when issue fields can't be set\n\n`gh issue create` creates the issue and then applies the deferred fields\n(type, parent, blocked-by, blocking) in a second step. When one of those\nmutations failed, createRun returned the error. The deferred PreserveInput\nsaw a non-nil error, wrote a recovery file and printed\n\n    X operation failed. To restore: gh issue create --recover <file>\n\nand the issue URL was never printed. The issue did exist, so the message\nwas misleading and invited a duplicate submission. This is reproducible by\ncreating an issue on a repository where you cannot set the issue type: the\nUpdateIssueIssueType mutation fails with a permissions error.\n\nThe issue already exists once api.IssueCreate returns, and\napi.DeferredUpdateIssue already joins its failures so one failing mutation\ndoes not abort the rest. Report the failure as a warning on stderr and\nstill print the issue URL.\n\nResolving the deferred fields is left alone: it runs before any mutation\nand reports invalid input such as `type \"Bugz\" not found`.\n\nFixes #13804","tree":{"sha":"6936549f1aeb653beae5dbf6a00da5990eee5b4b","url":"https://api.github.com/repos/cli/cli/git/trees/6936549f1aeb653beae5dbf6a00da5990eee5b4b"},"url":"https://api.github.com/repos/cli/cli/git/commits/c82266c2dcc3285033605501837434af1faeddfe","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/cli/cli/commits/c82266c2dcc3285033605501837434af1faeddfe","html_url":"https://github.com/cli/cli/commit/c82266c2dcc3285033605501837434af1faeddfe","comments_url":"https://api.github.com/repos/cli/cli/commits/c82266c2dcc3285033605501837434af1faeddfe/comments","author":{"login":"imkp1","id":28646172,"node_id":"MDQ6VXNlcjI4NjQ2MTcy","avatar_url":"https://avatars.githubusercontent.com/u/28646172?v=4","gravatar_id":"","url":"https://api.github.com/users/imkp1","html_url":"https://github.com/imkp1","followers_url":"https://api.github.com/users/imkp1/followers","following_url":"https://api.github.com/users/imkp1/following{/other_user}","gists_url":"https://api.github.com/users/imkp1/gists{/gist_id}","starred_url":"https://api.github.com/users/imkp1/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/imkp1/subscriptions","organizations_url":"https://api.github.com/users/imkp1/orgs","repos_url":"https://api.github.com/users/imkp1/repos","events_url":"https://api.github.com/users/imkp1/events{/privacy}","received_events_url":"https://api.github.com/users/imkp1/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"imkp1","id":28646172,"node_id":"MDQ6VXNlcjI4NjQ2MTcy","avatar_url":"https://avatars.githubusercontent.com/u/28646172?v=4","gravatar_id":"","url":"https://api.github.com/users/imkp1","html_url":"https://github.com/imkp1","followers_url":"https://api.github.com/users/imkp1/followers","following_url":"https://api.github.com/users/imkp1/following{/other_user}","gists_url":"https://api.github.com/users/imkp1/gists{/gist_id}","starred_url":"https://api.github.com/users/imkp1/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/imkp1/subscriptions","organizations_url":"https://api.github.com/users/imkp1/orgs","repos_url":"https://api.github.com/users/imkp1/repos","events_url":"https://api.github.com/users/imkp1/events{/privacy}","received_events_url":"https://api.github.com/users/imkp1/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"2af8c115be240a8018add33bf5c7a9ba5070a62c","url":"https://api.github.com/repos/cli/cli/commits/2af8c115be240a8018add33bf5c7a9ba5070a62c","html_url":"https://github.com/cli/cli/commit/2af8c115be240a8018add33bf5c7a9ba5070a62c"}]},{"sha":"8fbdb9b0f4e293af8a30ab1e0b79511fe1e37630","node_id":"C_kwDOTayMUNoAKDhmYmRiOWIwZjRlMjkzYWY4YTMwYWIxZTBiNzk1MTFmZTFlMzc2MzA","commit":{"author":{"name":"imkp1","email":"kprateek.bit@gmail.com","date":"2026-07-17T05:08:51Z"},"committer":{"name":"imkp1","email":"kprateek.bit@gmail.com","date":"2026-07-17T05:08:51Z"},"message":"Skip issue type picker without triage access\n\nThe interactive type picker is gated only on the repository having issue\ntypes. A viewer without triage access is offered the picker, picks a type,\nand UpdateIssueIssueType then fails after the issue already exists.\n\nGate the picker on ViewerCanTriage. IssueRepoInfo already selects\nviewerPermission, so this costs no extra request, and it skips the\nRepositoryIssueTypes fetch for viewers who cannot use the result.\n\nConfirmIssueSubmission already gates the metadata option the same way.","tree":{"sha":"5ed66b28d9a6a66778de6d237ba02d18e7f051bb","url":"https://api.github.com/repos/cli/cli/git/trees/5ed66b28d9a6a66778de6d237ba02d18e7f051bb"},"url":"https://api.github.com/repos/cli/cli/git/commits/8fbdb9b0f4e293af8a30ab1e0b79511fe1e37630","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/cli/cli/commits/8fbdb9b0f4e293af8a30ab1e0b79511fe1e37630","html_url":"https://github.com/cli/cli/commit/8fbdb9b0f4e293af8a30ab1e0b79511fe1e37630","comments_url":"https://api.github.com/repos/cli/cli/commits/8fbdb9b0f4e293af8a30ab1e0b79511fe1e37630/comments","author":{"login":"imkp1","id":28646172,"node_id":"MDQ6VXNlcjI4NjQ2MTcy","avatar_url":"https://avatars.githubusercontent.com/u/28646172?v=4","gravatar_id":"","url":"https://api.github.com/users/imkp1","html_url":"https://github.com/imkp1","followers_url":"https://api.github.com/users/imkp1/followers","following_url":"https://api.github.com/users/imkp1/following{/other_user}","gists_url":"https://api.github.com/users/imkp1/gists{/gist_id}","starred_url":"https://api.github.com/users/imkp1/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/imkp1/subscriptions","organizations_url":"https://api.github.com/users/imkp1/orgs","repos_url":"https://api.github.com/users/imkp1/repos","events_url":"https://api.github.com/users/imkp1/events{/privacy}","received_events_url":"https://api.github.com/users/imkp1/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"imkp1","id":28646172,"node_id":"MDQ6VXNlcjI4NjQ2MTcy","avatar_url":"https://avatars.githubusercontent.com/u/28646172?v=4","gravatar_id":"","url":"https://api.github.com/users/imkp1","html_url":"https://github.com/imkp1","followers_url":"https://api.github.com/users/imkp1/followers","following_url":"https://api.github.com/users/imkp1/following{/other_user}","gists_url":"https://api.github.com/users/imkp1/gists{/gist_id}","starred_url":"https://api.github.com/users/imkp1/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/imkp1/subscriptions","organizations_url":"https://api.github.com/users/imkp1/orgs","repos_url":"https://api.github.com/users/imkp1/repos","events_url":"https://api.github.com/users/imkp1/events{/privacy}","received_events_url":"https://api.github.com/users/imkp1/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c82266c2dcc3285033605501837434af1faeddfe","url":"https://api.github.com/repos/cli/cli/commits/c82266c2dcc3285033605501837434af1faeddfe","html_url":"https://github.com/cli/cli/commit/c82266c2dcc3285033605501837434af1faeddfe"}]},{"sha":"745dc6816d3178220ca73b34836f72b08750254b","node_id":"C_kwDOTayMUNoAKDc0NWRjNjgxNmQzMTc4MjIwY2E3M2IzNDgzNmY3MmIwODc1MDI1NGI","commit":{"author":{"name":"imkp1","email":"kprateek.bit@gmail.com","date":"2026-07-21T02:20:33Z"},"committer":{"name":"imkp1","email":"kprateek.bit@gmail.com","date":"2026-07-21T02:20:33Z"},"message":"Resolve deferred issue fields before creating the issue\n\nResolution of --type/--parent/--blocked-by/--blocking ran after\napi.IssueCreate, so a bad flag value failed fatally with the issue\nalready created: no URL printed, and a recovery file written in\ninteractive mode.\n\nResolve into DeferredUpdateIssueOptions before the create mutation and\nattach the issue ID afterwards. Only the post-create mutations stay\ndowngraded to a warning.","tree":{"sha":"90c5002b1e3103117abe4acd7923ae8700d61ae9","url":"https://api.github.com/repos/cli/cli/git/trees/90c5002b1e3103117abe4acd7923ae8700d61ae9"},"url":"https://api.github.com/repos/cli/cli/git/commits/745dc6816d3178220ca73b34836f72b08750254b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/cli/cli/commits/745dc6816d3178220ca73b34836f72b08750254b","html_url":"https://github.com/cli/cli/commit/745dc6816d3178220ca73b34836f72b08750254b","comments_url":"https://api.github.com/repos/cli/cli/commits/745dc6816d3178220ca73b34836f72b08750254b/comments","author":{"login":"imkp1","id":28646172,"node_id":"MDQ6VXNlcjI4NjQ2MTcy","avatar_url":"https://avatars.githubusercontent.com/u/28646172?v=4","gravatar_id":"","url":"https://api.github.com/users/imkp1","html_url":"https://github.com/imkp1","followers_url":"https://api.github.com/users/imkp1/followers","following_url":"https://api.github.com/users/imkp1/following{/other_user}","gists_url":"https://api.github.com/users/imkp1/gists{/gist_id}","starred_url":"https://api.github.com/users/imkp1/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/imkp1/subscriptions","organizations_url":"https://api.github.com/users/imkp1/orgs","repos_url":"https://api.github.com/users/imkp1/repos","events_url":"https://api.github.com/users/imkp1/events{/privacy}","recei